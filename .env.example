# Drives both builds: Vite inlines it for the web renderer, and electron/config.cjs
# reads this file for the desktop IPC transport.
VITE_API_BASE_URL=http://localhost:5000

# Origin the desktop transport presents. The backend CORS allowlist only accepts
# http://localhost:*, so this must stay an allowed value.
CRYPTA_API_ORIGIN=http://localhost:5173

# Set CRYPTA_ALLOW_SCREENSHOT=1 in the shell, NOT here — this file's siblings ship
# inside app.asar, so a committed value would disable the capture guard everywhere:
#   $env:CRYPTA_ALLOW_SCREENSHOT="1"; .\release\win-unpacked\Crypta.exe
# Without it the window is blocked from Snipping Tool, PrintScreen and screen-share.
